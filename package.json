{
  "name": "splitstick",
  "version": "0.1.0",
  "description": "An independently verifiable record of AI agent actions.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node redteam/generate.mjs",
    "redteam": "node redteam/redteam.mjs",
    "test": "npm run generate && npm run redteam",
    "requirements": "node requirements/build.mjs",
    "plan": "node requirements/plan.mjs",
    "backlog": "npm run requirements && npm run plan && npm run design",
    "design": "node requirements/design.mjs",
    "review": "node requirements/review.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --test packages/*/test/*.test.mjs",
    "bench": "node packages/core/test/bench.mjs",
    "verify": "npm run test:unit && npm run typecheck && npm test && npm run backlog && npm run review"
  },
  "dependencies": {
    "@open-multi-agent/core": "1.21.1",
    "zod": "^3.23.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.6.3"
  }
}
