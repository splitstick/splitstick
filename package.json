{
  "name": "splitstick",
  "version": "0.1.0",
  "description": "An independently verifiable record of AI agent actions.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "node redteam/generate.mjs",
    "redteam": "node redteam/redteam.mjs",
    "test": "npm run generate && npm run redteam && npm run redteam:splitstick",
    "requirements": "node requirements/build.mjs",
    "plan": "node requirements/plan.mjs",
    "backlog": "npm run requirements && npm run plan && npm run design && npm run lint",
    "design": "node requirements/design.mjs",
    "review": "node requirements/review.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --test packages/*/test/*.test.mjs bench/test/*.test.mjs redteam/test/*.test.mjs",
    "bench": "npm run bench:append:quick && npm run bench:latency",
    "verify": "node packages/verify/src/cli.mjs",
    "redteam:splitstick": "node redteam/splitstick.mjs",
    "bench:append": "node bench/append.mjs --events 1000000 --repeat 3",
    "bench:latency": "node bench/run-latency.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type library --omit dev",
    "bench:append:quick": "node bench/append.mjs --events 20000 --repeat 3",
    "lint": "node tools/lint-failure-codes.mjs && node tools/lint-claims.mjs && node tools/lint-practice-statement.mjs",
    "test:kms": "node --test packages/signer-aws-kms/test/integration.test.mjs",
    "drill:restore": "node packages/witness-self/drill/restore.mjs",
    "anchor-wps": "node tools/anchor-wps.mjs",
    "coverage": "node packages/verify/src/coverage-bin.mjs",
    "disclose": "node packages/verify/src/disclose-bin.mjs",
    "bench:verify": "node bench/verify.mjs",
    "bench:verify:quick": "node bench/verify.mjs --events 5000 --repeat 1",
    "conformance": "node tools/conformance.mjs"
  },
  "dependencies": {
    "@open-multi-agent/core": "1.21.1",
    "zod": "^3.23.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "5.6.3"
  }
}
